    {
      "name": "Login",
      "item": [
        {
          "name": "Login Atendente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Tempo de resposta < 5000ms\", function () { pm.expect(pm.response.responseTime).to.be.below(5000); });",
                  "pm.test(\"Resposta tem accessToken\", function () { var json = pm.response.json(); pm.expect(json.accessToken).to.be.a(\"string\"); });",
                  "pm.test(\"tokenType é Bearer\", function () { var json = pm.response.json(); pm.expect(json.tokenType).to.eql(\"Bearer\"); });",
                  "pm.test(\"expiresIn é número\", function () { var json = pm.response.json(); pm.expect(json.expiresIn).to.be.a(\"number\"); });",
                  "pm.environment.set(\"tokenAtendente\", pm.response.json().accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{emailAtendente}}\",\"senha\":\"{{senhaAtendente}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
