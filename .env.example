# Exemplo local, nunca usar como configuracao produtiva.
# Preencher REPLACE_WITH_* somente em .env fora do Git; nao inserir credenciais aqui.
AUTH_ENVIRONMENT=local
AUTH_DB_HOST=127.0.0.1
AUTH_DB_PORT=5544
AUTH_DB_NAME=oficina_auth
AUTH_DB_USER=oficina_auth
AUTH_DB_PASSWORD=REPLACE_WITH_AUTH_DB_PASSWORD
AUTH_DB_SSLMODE=disable
AUTH_KEY_PROVIDER=local-file
AUTH_LOCAL_KEY_FILE=REPLACE_WITH_AUTH_LOCAL_KEY_FILE
AUTH_JWT_ISSUER=https://auth.local.test
AUTH_JWT_AUDIENCE=oficina
AUTH_JWT_TTL_SECONDS=900
